# Set these in the Render dashboard (production) or export them for a local run.
VIETPHONICS_ENV=development            # local only. Unset = production (no demo accounts, no OTP, strict CORS)
MONGODB_URI=mongodb+srv://<user>:<password>@<cluster>.mongodb.net/?retryWrites=true&w=majority
MONGODB_DB=vietphonics
# MONGODB_URI=mongomock://             # in-memory database for quick local runs/tests (refused in production)
# VIETPHONICS_ADMIN_EMAIL=admin@yourdomain.vn     # production only: the first admin account
# VIETPHONICS_ADMIN_PASSWORD=                      # production only: a long unique password
# VIETPHONICS_DEMO_OTP=                            # leave empty in production: no SMS is connected, so OTP sign-in stays off
# VIETPHONICS_CORS=https://your-app.vercel.app     # only when the browser calls the API directly
